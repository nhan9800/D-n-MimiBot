# MIMI BOT — Node >=22.12.0 nạp .env tự động trước module.
# Biến đã đặt trên panel/môi trường được giữ ưu tiên. Không commit .env thật.
# config.json cũ (token/clientId/mimiApiToken) vẫn được hỗ trợ để nâng cấp an toàn.

# Discord bot — lấy từ Discord Developer Portal.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Link cộng đồng và website.
DISCORD_SUPPORT_URL=https://discord.gg/gBUHY3qph2
MIMI_WEB_BASE=https://mimibot.id.vn

# Internal API: để token trống thì API không khởi động.
# Sinh token ngẫu nhiên mạnh; phải trùng MIMI_API_TOKEN phía website.
MIMI_API_TOKEN=
MIMI_API_PORT=8787
# Dùng loopback khi web cùng máy; khác máy cần firewall/TLS/tunnel phù hợp.
MIMI_API_HOST=127.0.0.1
# IP máy chủ web/proxy được phép, phân cách bằng dấu phẩy; trống là không giới hạn IP.
MIMI_API_ALLOW_IPS=
# Chỉ IP reverse proxy thật được tin header X-Forwarded-For.
MIMI_TRUSTED_PROXIES=

# Khoá riêng ký link dashboard (khuyến nghị); trống thì dùng service token.
MIMI_DASHBOARD_SECRET=
# Tuỳ chọn token quản trị riêng. Không có giá trị mặc định.
# API quản trị yêu cầu POST + Authorization: Bearer <token>, không nhận secret trong URL/body.
ADMIN_SECRET=
# Tuỳ chọn khoá ký mã kích hoạt mới. Mã luôn phải có trong kho đã phát hành.
MIMI_LICENSE_SECRET=

# Role/user để hiển thị danh sách đội ngũ trên website, cấu hình của bên vận hành.
FOUNDER_ROLE_ID=
FOUNDER_DISCORD_ID=
DEV_DISCORD_ID=
# Chỉ guild này được dùng lấy đội ngũ website; không cấu hình thì trả dữ liệu rỗng.
# Nếu trống, API có thể dùng MIMI_HOME_GUILD_ID được đặt rõ ràng bên dưới.
SUPPORT_SERVER_ID=

# Tuỳ chọn đường dẫn ffmpeg nếu cần thay binary/PATH.
FFMPEG_PATH=

# Tùy chọn danh tính người vận hành và server nhà; có fallback tương thích cấu hình cũ.
MIMI_OWNER_ID=
MIMI_HOME_GUILD_ID=

# Quyền riêng tư: đặt true khi muốn chuyển tiếp DM/mention đến người vận hành.
# Mẫu cấu hình mới tắt chuyển tiếp; môi trường cũ vẫn có fallback tương thích.
FORWARD_BOT_DMS_TO_OWNER=false
FORWARD_BOT_MENTIONS_TO_OWNER=false
